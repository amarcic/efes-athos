					<lb n="1"/>χειρὶ <persName type="attested" ref="#pers60">Θεοφάν<hi rend="ligature">ου</hi>ς</persName>
					<lb n="2"/><date from="1592-01-01" to="1592-08-31">ἐν ἔτει <num value="7100">ζρ</num> <num value="1592">αφϞβ</num></date>                
