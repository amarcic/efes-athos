            <div type="edition" xml:space="preserve">
               <div type="textpart" subtype="pulpit" n="1">
               <ab><lb n="1"/><g ref="#crux">†</g> <lb n="1"/>Ἐκατεσκ
               <lb n="2" break="no"/>ευάσθη
               <lb n="3" break="no"/>σαν τὰ πα
               <lb n="4" break="no"/>ρόντα ἀ
               <lb n="5" break="no"/>ναλόγια
               <lb n="6"/>τοῦ Παντο
               <lb n="7" break="no"/>κράτορος <expan><abbr>Χ</abbr><ex>ριστο</ex>ῦ</expan> διὰ χει</ab></div>
               <div type="textpart" subtype="pulpit" n="2"><ab><lb n="8" break="no"/>ρὸς τῶν <rs type="occupation" ref="prf0003">μα
               <lb n="9" break="no"/>στόρων</rs>
               <lb n="10"/><persName type="attested" ref="#pers40">Θεοδοσίου</persName>,
               <lb n="11"/><persName type="attested" ref="#pers41">Κωνσταντί
               <lb n="12" break="no"/>νου</persName>, <persName type="attested" ref="#pers42">Βασιλείο
               <lb n="13" break="no"/>ου</persName> εἰς <placeName ref="https://pleiades.stoa.org/places/854743">Κάφαν</placeName> ἔ
               <lb n="14" break="no"/>τους <date from="1636-09-01" to="1637-08-31"><num value="7145">ζρμε</num></date></ab></div>
            </div>
